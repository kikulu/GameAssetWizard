{
  "name": "game-asset-prompt-generator",
  "version": "1.3.1",
  "private": true,
  "description": "以詞庫驅動的遊戲美術提示詞產生器，支援 Draw Things 本機產圖。同時提供網頁與 Electron 桌面版。",
  "author": "kikulu <kikulu@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kikulu/GameAssetWizard.git"
  },
  "bugs": {
    "url": "https://github.com/kikulu/GameAssetWizard/issues"
  },
  "homepage": "https://github.com/kikulu/GameAssetWizard#readme",
  "keywords": [
    "game-art",
    "prompt-generator",
    "stable-diffusion",
    "comfyui",
    "draw-things",
    "electron"
  ],
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "proxy": "node server_proxy.js",
    "electron": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "check": "node --check server.js && node --check server_proxy.js && node --check electron/main.js && node --check electron/preload.js && node --check assets/js/platform.js && node --check assets/js/app.js && node --check assets/js/generation.js && node --check assets/js/styleguide.js",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.example.game-asset-prompt-generator",
    "productName": "Game Asset Prompt Generator",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "assets/**/*",
      "config_sheets/**/*",
      "locales/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.graphics-design"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
